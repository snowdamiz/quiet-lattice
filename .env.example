# Copy to .env and adjust. Read by infra/docker-compose.yml and the server.
POSTGRES_USER=astra
POSTGRES_PASSWORD=astra
POSTGRES_DB=astra
POSTGRES_PORT=55432
REDIS_PORT=56379
DATABASE_URL=postgres://astra:astra@127.0.0.1:55432/astra
REDIS_URL=redis://127.0.0.1:56379
JWT_SECRET=dev-only-change-me

# Developer tooling (docs/ARCHITECTURE.md, Developer tooling). Never set these in production.
# ASTRA_DEV_LOGIN=1            # POST /auth/dev signs into dev-<name> accounts without a password (loopback HOST only
#                              # when NODE_ENV is unset; the server refuses to start with it in production)
# ASTRA_ADMIN_SECRET=          # turns on the loopback admin channel for `pnpm --filter @astra/server cli`; no whitespace
# ASTRA_ADMIN_PORT=8788
# ASTRA_METRICS_S=10           # per-zone tick metrics in the log every N seconds (0 turns them off)
