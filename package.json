{
  "name": "next-horizon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @astra/client dev",
    "dev:server": "pnpm --filter @astra/server dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @astra/client preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "db:up": "docker compose --project-directory . -f infra/docker-compose.yml up -d --wait && docker compose --project-directory . -f infra/docker-compose.yml ps --format \"{{.Service}}: {{.Health}}\"",
    "db:down": "docker compose --project-directory . -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @astra/server db:migrate",
    "test": "vitest run",
    "smoke": "pnpm --filter @astra/tools smoke",
    "gate:removed": "tsx packages/tools/src/gates/removed.ts",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
